#-(and)
(defmacro define-structure (name-and-options &rest doc-and-slots)
  (multiple-value-bind (name conc-name constructors copier
                        include initial-offset predicate
                        print-function print-object
                        structure-type-p structure-type
                        documentation slots slot-names accessors)
      (parse-structure-definition name-and-options doc-and-slots)
    (generate-lisp-structure name conc-name constructors copier
                             include initial-offset predicate
                             print-function print-object
                             structure-type-p structure-type
                             documentation slots slot-names accessors)))


(defun generate-structure-functions ()
  (flet ((generate (header)
           (let ((*header* header)
                 (*kernel-functions* '()))


             (generate-structure '(lexical-variable
                                   (:constructor env/make-lexical-variable)
                                   (:constructor env/lexical-variable (name))
                                   (:predicate   env/lexical-variable-p)
                                   (:conc-name   env/lexical-variable-))
                                 '(name value))

             (generate-structure '(constant-variable
                                   (:constructor env/make-constant-variable)
                                   (:constructor env/constant-variable (name))
                                   (:predicate   env/constant-variable-p)
                                   (:conc-name   env/constant-variable-))
                                 '(name value))

             (generate-structure '(global-special-variable
                                   (:constructor env/make-global-special-variable)
                                   (:constructor env/global-special-variable (name))
                                   (:predicate   env/global-special-variable-p)
                                   (:conc-name   env/global-special-variable-))
                                 '(name value))

             (generate-structure '(local-special-variable
                                   (:constructor env/make-local-special-variable)
                                   (:constructor env/local-special-variable (name))
                                   (:predicate   env/local-special-variable-p)
                                   (:conc-name   env/local-special-variable-))
                                 '(name saved-boundp saved-value))

             (generate-structure '(global-function
                                   (:constructor env/make-global-function)
                                   (:constructor env/global-function (name))
                                   (:predicate   env/global-function-p)
                                   (:conc-name   env/global-function-))
                                 '(name lambda-list body compiler-macro))

             ;; ENV is the DEFINING lexical environment the local function's
             ;; body closes over when called: for FLET the environment
             ;; ENCLOSING the flet (siblings invisible, CLHS 3.1.2.1.2.1);
             ;; for LABELS the new environment holding all the bindings
             ;; (siblings visible).  NIL means "close over the environment
             ;; current at the call site" (the pre-v1.8.36 behavior, kept as
             ;; the fallback for wrappers built without an environment).
             (generate-structure '(local-function
                                   (:constructor env/make-local-function)
                                   (:constructor env/local-function (name))
                                   (:predicate   env/local-function-p)
                                   (:conc-name   env/local-function-))
                                 '(name lambda-list body env))

             (generate-structure '(global-symbol-macro
                                   (:constructor env/make-global-symbol-macro)
                                   (:constructor env/global-symbol-macro (name))
                                   (:predicate   env/global-symbol-macro-p)
                                   (:conc-name   env/global-symbol-macro-))
                                 '(name expansion))

             (generate-structure '(local-symbol-macro
                                   (:constructor env/make-local-symbol-macro)
                                   (:constructor env/local-symbol-macro (name))
                                   (:predicate   env/local-symbol-macro-p)
                                   (:conc-name   env/local-symbol-macro-))
                                 '(name expansion))

             (generate-structure '(global-macro
                                   (:constructor env/make-global-macro)
                                   (:constructor env/global-macro (name))
                                   (:predicate   env/global-macro-p)
                                   (:conc-name   env/global-macro-))
                                 '(name lambda-list body))

             (generate-structure '(local-macro
                                   (:constructor env/make-local-macro)
                                   (:constructor env/local-macro (name))
                                   (:predicate   env/local-macro-p)
                                   (:conc-name   env/local-macro-))
                                 '(name lambda-list body))

             ;; (generate-structure '(package
             ;;                       (:constructor make-package)
             ;;                       (:predicate   packagep))
             ;;                     '(name
             ;;                       nicknames
             ;;                       shadowing-symbols
             ;;                       use-list
             ;;                       used-by-list))

             )))

    (with-open-file (*standard-output* "kernel_structure_functions.h"
                                       :direction :output
                                       :if-does-not-exist :create
                                       :if-exists :supersede)
      (write-line "#ifndef kernel_structure_functions_h")
      (write-line "#define kernel_structure_functions_h")
      (write-line "#include \"kernel_types.h\"")
      (terpri)
      (generate :kernel-header)
      (terpri)
      (write-line "#endif"))

    (with-open-file (*standard-output* "kernel_structure_functions.c"
                                       :direction :output
                                       :if-does-not-exist :create
                                       :if-exists :supersede)
      (write-line "#include \"kernel_structure_functions.h\"")
      (write-line "#include \"structure_functions.h\"")
      (write-line "#include \"kernel.h\"")
      (terpri)
      (generate :kernel-source)
      (terpri)
      (write-line "/**** THE END ****/"))

    (with-open-file (*standard-output* "structure_functions.h"
                                       :direction :output
                                       :if-does-not-exist :create
                                       :if-exists :supersede)
      (write-line "#ifndef structure_functions_h")
      (write-line "#define structure_functions_h")
      (write-line "#include \"kernel_types.h\"")
      (write-line "#include \"kernel.h\"")
      (terpri)
      (generate :header)
      (terpri)
      (write-line "void kernel_initialize_structure_functions(void);")
      (terpri)
      (write-line "#endif"))


    (with-open-file (*standard-output* "structure_functions.c"
                                       :direction :output
                                       :if-does-not-exist :create
                                       :if-exists :supersede)
      (write-line "#include \"structure_functions.h\"")
      (write-line "#include \"kernel_structure_functions.h\"")
      (write-line "#include \"kernel.h\"")
      (write-line "#include \"cons.h\"")
      (write-line "#include \"variable.h\"")
      (write-line "#include \"stream.h\"")
      (write-line "#include \"reader.h\"")
      (write-line "#include \"printer.h\"")
      (terpri)
      (generate :source)
      (terpri)
      (write-line "void kernel_initialize_structure_functions(void){")
      (generate :symbols)
      (generate :initialisation)
      (write-line "}")
      (write-line "/**** THE END ****/"))

    (with-open-file (*standard-output* "lisp/kernel-package+structure.lisp"
                                       :direction :output
                                       :if-does-not-exist :create
                                       :if-exists :supersede)
      (write-line "(DEFPACKAGE \"KERNEL\"")
      (write-line "  (:USE)")
      (write-line "  (:EXPORT")
      (write-string "   ")
      (setf *column* 3)
      (setf *print-right-margin* 80)
      (generate :package-exports)
      ;; TODO: better collect symbols from the OBARRAY dynamically?
      ;; TODO: we're missing the *symbols* and perhaps others.
      (write-line "))")
      (write-line "(IN-PACKAGE \"KERNEL\")")
      (let ((*package* (find-package "KERNEL"))
            (*print-right-margin* 36))
        (generate :lisp-definitions))
      (terpri))

    (values)))
