(defun in-kernel (tree)
  (cond
    ((null tree) tree)
    ((keywordp tree) tree)
    ((symbolp tree) (intern (string tree) "KERNEL"))
    ((atom tree)    tree)
    (t (cons (in-kernel (car tree))
             (in-kernel (cdr tree))))))

(defun generate-structure (name-and-options doc-and-slots)
  (multiple-value-bind (name conc-name constructors copier
                        include initial-offset predicate
                        print-function print-object
                        structure-type-p structure-type
                        documentation slots slot-names accessors
                        named)
      (parse-structure-definition name-and-options doc-and-slots)
    (declare (ignore conc-name print-object print-function
                     structure-type-p documentation slots named))
    (when structure-type
      (error "structures of types ~S are not supported for built-in structures"
             structure-type))
    (let ((superclass (or include 'structure-object)))

      (when (eql *header* :kernel-header)
        (format t "extern Ref ~A;~%" (class-c-name name)))

      (when (eql *header* :lisp-definitions)
        (pprint (in-kernel `(defstruct ,name-and-options ,@doc-and-slots))))

      (when (member *header* '(:header :source
                               :kernel-header
                               :package-exports))
        (when predicate
          (generate-kernel-function predicate '(object) :values '(boolean)))
        (dolist (constructor constructors)
          (if (listp constructor)
              ;; BOA constructor
              (generate-kernel-function (first constructor) (second constructor))
              (generate-kernel-function constructor (cons '&key slot-names))))
        (when copier
          (generate-kernel-function copier (list name)))
        (map nil (lambda  (accessor slot-name)
                   (generate-kernel-function accessor (list name))
                   (generate-kernel-function (scat 'set- accessor) (list (scat 'new- slot-name) name)))
             accessors slot-names))


      (when (eql *header* :kernel-source)

        (format t "Ref ~A;~%" (class-c-name name))

        ;; The headers of those functions are generated by generate-kernel-function :header

        (let ((*header* :kernel-signature))

          (when predicate
            (generate-kernel-function predicate '(object) :values '(boolean))
            (write-line "{")
            (format t "    return typep(~A,~A);}~%" (c-par-name 'object) (class-c-name name)))

          (flet ((generate-constructor-body (constructor-name slots)
                   (declare (ignorable constructor-name))
                   ;; (format *TRACE-OUTPUT* "Constructor body ~S ~S~%" constructor-name slots)
                   (format t "{~%")
                   (format t "    uword pool=open_live_pool();~%")
                   (dolist (slot-name slots)
                     (format t  "    add_to_live_pool(~A);~%" (c-par-name slot-name)))

                   (format t "    Ref instance = make_structure_instance(~A);~%"   (class-c-name name))
                   ;; TODO: we should compute the indexes at compilation-time (now).
                   (format t "    Ref pos = structure_class_instance_slots(~A);~%" (class-c-name name))
                   (dolist (slot-name slots)
                     (format t "    {   Ref entry = assq(S(~A),pos);~%" (symbol-name slot-name))
                     (format t "        if(nullp(entry)){ FATAL(\"%s\",\"~A is not a slot-name of ~A\"); }~%"
                             (symbol-name slot-name) (symbol-name name))
                     (format t "        structure_set(~A,instance,cdr(entry));}~%" (c-par-name slot-name)))
                   (format t "    close_live_pool(pool);~%")
                   (format t "    add_to_live_pool(instance);   /* re-root: close_live_pool trimmed the fresh instance */~%")
                   (format t "    return instance;}~%")))

            (dolist (constructor constructors)
              (if (listp constructor)
                  (progn                ; BOA constructor
                    (generate-kernel-function (first constructor) (second constructor))
                    (generate-constructor-body (first constructor) (second constructor)))
                  (progn
                    (generate-kernel-function constructor (cons '&key slot-names))
                    (generate-constructor-body constructor slot-names)))))

          (let ((old-struct (scat name '-instance)))

            (when copier
              (generate-kernel-function copier (list old-struct))
              (format t "{~%")
              (format t "    uword pool=open_live_pool();~%")
              (format t "    add_to_live_pool(~A);~%" (c-par-name old-struct))
              (format t "    Ref instance = make_structure_instance(~A);~%"   (class-c-name name))
              (format t "    Ref size = structure_class_instance_size(~A);~%" (class-c-name name))
              (format t "    for(word i = integer_value(size)-1;0<=i;i--){~%")
              (format t "        Ref index = integer_from_word(i);~%")
              (format t "        structure_set(structure_get(~A,index),instance,index);}~%" (c-par-name old-struct))
              (format t "    close_live_pool(pool);~%")
              (format t "    add_to_live_pool(instance);   /* re-root: close_live_pool trimmed the fresh instance */~%")
              (format t "    return instance;}~%"))

            (map nil (lambda (accessor slot-name)

                       (generate-kernel-function accessor (list old-struct))
                       (format t "{~%")
                       (format t "    uword pool=open_live_pool();~%")
                       (format t "    add_to_live_pool(~A);~%" (c-par-name old-struct))
                       (format t "    check_type(~A,~A);~%" (c-par-name old-struct) (class-c-name name))
                       ;; TODO: we should compute the indexes at compilation-time (now).
                       (format t "    Ref pos = structure_class_instance_slots(~A);~%" (class-c-name name))
                       (format t "    Ref entry = assq(S(~A),pos);~%" (symbol-name slot-name))
                       (format t "    if(nullp(entry)){ FATAL(\"%s\",\"~A is not a slot-name of ~A\"); }~%"
                               (symbol-name slot-name) (symbol-name name))
                       (format t "    Ref result=structure_get(~A,cdr(entry));~%" (c-par-name old-struct))
                       (format t "    close_live_pool(pool);~%")
                       (format t "    return result;}~%")

                       (let ((new-value (scat 'new- slot-name)))
                         (generate-kernel-function (scat 'set- accessor) (list new-value old-struct))
                         (format t "{~%")
                         (format t "    uword pool=open_live_pool();~%")
                         (format t "    add_to_live_pool(~A);~%" (c-par-name new-value))
                         (format t "    add_to_live_pool(~A);~%" (c-par-name old-struct))
                         (format t "    check_type(~A,~A);~%" (c-par-name old-struct) (class-c-name name))
                         ;; TODO: we should compute the indexes at compilation-time (now).
                         (format t "    Ref pos = structure_class_instance_slots(~A);~%" (class-c-name name))
                         (format t "    Ref entry = assq(S(~A),pos);~%" (symbol-name slot-name))
                         (format t "    if(nullp(entry)){ FATAL(\"%s\",\"~A is not a slot-name of ~A\"); }~%"
                                 (symbol-name slot-name) (symbol-name name))
                         (format t "    structure_set(~A,~A,cdr(entry));~%" (c-par-name new-value) (c-par-name old-struct))
                         (format t "    close_live_pool(pool);~%")
                         (format t "    return ~A;}~%" (c-par-name new-value))))

                 accessors slot-names))))

      (when (eql *header* :initialisation)

        (format t "    ~32A = make_structure_class(S(~A),~A,integer_from_uword(~A),~A);~%"
                (class-c-name name)
                (c-symbol-name name)
                (class-c-name superclass)
                (or initial-offset 0)
                (genlist slot-names))

        )
      )))




