;;;; Audit v2: only hard evidence (no typep — bocl typep returns NIL on
;;;; unknown specifiers instead of signalling).
(let* ((form (with-open-file (s "bootstrap/cl-exports.lisp")
               (read s)))
       (names (second (second form)))
       (n-specop 0) (n-macro 0) (n-fun 0) (n-bound 0) (n-class 0)
       (unaccounted '()))
  (dolist (name names)
    (let* ((s (find-symbol name "COMMON-LISP"))
           (specop (special-operator-p s))
           (macro  (and (not specop) (macro-function s)))
           (fun    (and (not specop) (not macro) (fboundp s)))
           (bound  (boundp s))
           (cls    (find-class s nil)))
      (when specop (setq n-specop (+ n-specop 1)))
      (when macro  (setq n-macro  (+ n-macro 1)))
      (when fun    (setq n-fun    (+ n-fun 1)))
      (when bound  (setq n-bound  (+ n-bound 1)))
      (when (and cls (not specop) (not macro) (not fun) (not bound))
        (setq n-class (+ n-class 1)))
      (unless (or specop macro fun bound cls)
        (setq unaccounted (cons name unaccounted)))))
  (format t "~%TOTAL ~D~%" (length names))
  (format t "special-operators ~D~%" n-specop)
  (format t "macros ~D~%" n-macro)
  (format t "functions ~D~%" n-fun)
  (format t "bound (vars+constants) ~D~%" n-bound)
  (format t "class-only ~D~%" n-class)
  (format t "NO-HARD-EVIDENCE ~D:~%" (length unaccounted))
  (dolist (u (reverse unaccounted)) (format t "  ~A~%" u)))
