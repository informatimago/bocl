  (defparameter *asdf-file* (first (bocl::module-files (find-module :asdf))))
  (list (lisp-implementation-version)
        (time (compile-file *asdf-file* :output-file "/tmp/asdf.fasl"))
        (time (load *asdf-file*))
        (time (load "/tmp/asdf.fasl")))
